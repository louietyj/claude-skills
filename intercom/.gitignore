# Holds the CLI and device tokens: read a live conversation, buzz Louie's watch.
# This repo is public.
config.json
!config.example.json

# Packaged skill -- bundles the config, so the artefact is a credential too.
*.zip

# Soniox key ("dev") for local probes; the Worker has its own, as a secret.
dev/soniox.key
# Telnyx API key, for provisioning from a checkout; the Worker gets its own copy as a secret.
dev/telnyx.key
# Krisp API key, for voice-isolation probes.
dev/krisp.key

__pycache__/
.wrangler/
dev/*.webm
dev/*.wav

# wasm build trees (sources, objects); aec/aec3.wasm and opus/opus.wasm are the products.
aec/.work/
opus/.work/
