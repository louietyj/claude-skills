{
  "catalogUrl": "https://www.dropbox.com/scl/fi/.../mcp-catalog.json?rlkey=...",
  "authorizeUrl": "https://lmcps-authorize.example.com",
  "mcpServers": {
    "tomtom": {
      "type": "http",
      "url": "https://mcp.tomtom.com/maps",
      "headers": { "tomtom-api-key": "YOUR_KEY_HERE" },
      "description": "geocoding, routing, live traffic, EV range, places search"
    },
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com",
      "headers": { "Authorization": "Bearer ${LMCPS_KEY}" },
      "keys": [
        { "label": "me@gmail.com", "LMCPS_KEY": "apify_api_..." },
        { "label": "alt@gmail.com", "LMCPS_KEY": "apify_api_..." }
      ],
      "description": "web scraping and data extraction via Apify Actors",
      "permissions": { "ask": ["call-actor"] }
    },
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone", "Europe/London"],
      "description": "current time in any timezone, and timezone conversion",
      "permissions": { "default": "allow" }
    },
    "sqlite": {
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "/tmp/example.db"],
      "env": { "SOME_TOKEN": "${SOME_TOKEN:-}" },
      "description": "query and modify a local SQLite database"
    }
  }
}
